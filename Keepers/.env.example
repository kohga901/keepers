EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Recommendation/backend server URL (ngrok tunnels are ephemeral - ask whoever
# is running server/ for the current URL and update your own .env.local).
EXPO_PUBLIC_SERVER_URL=

# LOCAL DEVELOPMENT ONLY. Expo embeds EXPO_PUBLIC_* values in the client bundle,
# so use only short-lived, restricted test keys and never set these for releases.
# Copy the provider key you need into an ignored .env.local file.
EXPO_PUBLIC_KEEPERS_GOOGLE_AI_API_KEY=
EXPO_PUBLIC_KEEPERS_OPENAI_API_KEY=
EXPO_PUBLIC_KEEPERS_ANTHROPIC_API_KEY=
