SUPABASE_URL=
SUPABASE_KEY=

# Server-owned AI lookup: google or openai. Configure only the selected provider's key.
AI_LOOKUP_PROVIDER=google
GOOGLE_AI_API_KEY=
# OPENAI_API_KEY=
# Optional: override the selected provider's existing model default.
# AI_LOOKUP_MODEL=

# Per server process, reset daily at midnight UTC. Zero disables lookup.
AI_LOOKUP_USER_DAILY_LIMIT=20
AI_LOOKUP_DAILY_LIMIT=500
