SUPABASE_URL=
SUPABASE_KEY=

# OpenAI is primary; Gemini is tried once if the OpenAI lookup fails.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# Optional: override OpenAI's model. Gemini uses gemini-3.5-flash-lite.
# AI_LOOKUP_MODEL=gpt-6.1-terra

# Per server process, reset daily at midnight UTC. Zero disables lookup.
# A lookup can make one OpenAI call and one Gemini call within this allowance.
AI_LOOKUP_USER_DAILY_LIMIT=20
AI_LOOKUP_DAILY_LIMIT=500
