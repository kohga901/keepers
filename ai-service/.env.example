# The adapter used when a request does not include a provider field.
AI_PROVIDER=google
HOST=127.0.0.1
PORT=8787

# Use * for local testing, or a comma-separated allowlist when deployed.
CORS_ORIGINS=*

# Google AI Studio / Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# OpenAI Platform (this is separate from a ChatGPT subscription)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
